# ================================================================
# monday-orphaned-account-report
# Monday token needs permission to query users.
# Entra app needs User.Read.All (application) + admin consent.
# ================================================================

# --- Monday (always) ---
PDT_MONDAY_API_TOKEN=

# --- Entra ID (always) ---
PDT_AZURE_TENANT_ID=
PDT_AZURE_CLIENT_ID=

# Entra ID auth: pick ONE mode
## Mode A -- client secret
PDT_AZURE_CLIENT_SECRET=
## Mode B -- certificate (PFX). Wins if both modes are set.
### A relative path is relative to the repo root, e.g. .secrets/app.pfx
PDT_AZURE_PRIVATE_KEY_PATH=
### Or inline the PFX as base64; this wins over the path.
### Deploy converts PDT_AZURE_PRIVATE_KEY_PATH to this secret automatically.
PDT_AZURE_PRIVATE_KEY_B64=
## Optional; leave empty for an unencrypted PFX.
PDT_AZURE_PRIVATE_KEY_PASSWORD=
