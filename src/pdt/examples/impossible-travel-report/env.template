# ================================================================
# impossible-travel-report
# App needs AuditLog.Read.All (application) + admin consent.
# Tenant needs Entra ID license level P1 or P2 for sign-in logs.
# ================================================================

# --- Entra ID (always) ---
PDT_AZURE_TENANT_ID=
PDT_AZURE_CLIENT_ID=

# Entra ID auth: pick ONE mode
## Mode A — client secret
PDT_AZURE_CLIENT_SECRET=
## Mode B — certificate (PFX). Wins if both modes are set.
### A relative path is relative to the repo root, e.g. .secrets/app.pfx
PDT_AZURE_PRIVATE_KEY_PATH=
### Or inline the PFX as base64 of the file; wins over the path.
### Deploy converts PDT_AZURE_PRIVATE_KEY_PATH into this secret automatically.
PDT_AZURE_PRIVATE_KEY_B64=
## Optional; omit if the PFX is unencrypted.
PDT_AZURE_PRIVATE_KEY_PASSWORD=

# Email configuration - choose one complete block.
# A partial block is an error. If every block is empty, the message prints to stdout.
## smtp
PDT_SMTP_HOST=
# Optional; defaults to 587 (STARTTLS). Use 465 for implicit TLS.
PDT_SMTP_PORT=
PDT_SMTP_USER=
# Set a password for password auth. Leave it empty for supported OAuth hosts.
PDT_SMTP_PASSWORD=
# OAuth supports smtp.gmail.com, smtp.office365.com, and smtp-mail.outlook.com.
# This value is optional because PDT can infer it from those hosts.
PDT_SMTP_AUTH=
PDT_SMTP_OAUTH_CLIENT_ID=
# Required for Google. Leave empty for Microsoft.
PDT_SMTP_OAUTH_CLIENT_SECRET=
# Microsoft only; defaults to common.
PDT_SMTP_OAUTH_TENANT_ID=
# PDT adds this value after browser authorization. Do not set it manually.
PDT_SMTP_OAUTH_CACHE_B64=
## graph
PDT_GRAPH_MAIL_USER=
PDT_GRAPH_MAIL_CLIENT_ID=
# Optional; defaults to common.
PDT_GRAPH_MAIL_TENANT_ID=
# PDT adds this value after browser authorization. Do not set it manually.
PDT_GRAPH_MAIL_CACHE_B64=
## ses
# Set a region. With keys empty, this will attempt to use the logged-in AWS account defaults.
# (AWS_PROFILE, environment credentials, container/task role, instance role, etc.).
PDT_SES_REGION=
# Optionally, specify the access key to use.
PDT_SES_ACCESS_KEY_ID=
PDT_SES_SECRET_ACCESS_KEY=
## resend
PDT_RESEND_API_KEY=
