# App needs User.Read.All and LicenseAssignment.ReadWrite.All
# application permissions with admin consent.

PDT_AZURE_TENANT_ID=
PDT_AZURE_CLIENT_ID=

# Choose a client secret or a PFX certificate.
PDT_AZURE_CLIENT_SECRET=
# A relative certificate path is relative to the repository root.
PDT_AZURE_PRIVATE_KEY_PATH=
# Base64 certificate data takes priority over the certificate path.
PDT_AZURE_PRIVATE_KEY_B64=
# Leave the password empty for an unencrypted certificate.
PDT_AZURE_PRIVATE_KEY_PASSWORD=

# Email configuration is optional. Choose one complete block.
# SMTP
PDT_SMTP_HOST=
PDT_SMTP_PORT=
PDT_SMTP_USER=
PDT_SMTP_PASSWORD=
PDT_SMTP_AUTH=
PDT_SMTP_OAUTH_CLIENT_ID=
PDT_SMTP_OAUTH_CLIENT_SECRET=
PDT_SMTP_OAUTH_TENANT_ID=
PDT_SMTP_OAUTH_CACHE_B64=
# Microsoft Graph
PDT_GRAPH_MAIL_USER=
PDT_GRAPH_MAIL_CLIENT_ID=
PDT_GRAPH_MAIL_TENANT_ID=
PDT_GRAPH_MAIL_CACHE_B64=
# Amazon SES
PDT_SES_REGION=
PDT_SES_ACCESS_KEY_ID=
PDT_SES_SECRET_ACCESS_KEY=
# Resend
PDT_RESEND_API_KEY=
