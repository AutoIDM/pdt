# ================================================================
# intune-export
# The Entra app needs these Microsoft Graph application permissions,
# with admin consent: DeviceManagementConfiguration.Read.All,
# DeviceManagementApps.Read.All, DeviceManagementServiceConfig.Read.All,
# DeviceManagementRBAC.Read.All, DeviceManagementScripts.Read.All,
# DeviceManagementManagedDevices.Read.All, CloudPC.Read.All,
# Policy.Read.All, Agreement.Read.All, Organization.Read.All,
# Group.Read.All, User.Read.All.
# ================================================================

PDT_AZURE_TENANT_ID=
PDT_AZURE_CLIENT_ID=
PDT_AZURE_CLIENT_SECRET=

# Optional: the app package keys for export_app_files, as one JSON object
# that maps each IntuneManagement encryption file name, without .json, to
# that file's content. It fits the keys of about 50 apps on Azure (a Key
# Vault secret holds at most 25 KB) and about 70 on Windows (an env var
# holds at most 32767 characters).
INTUNE_APP_ENCRYPTION_KEYS=
