<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="pdt"
           Manufacturer="AutoIDM"
           Version="$(Version)"
           UpgradeCode="{367B1CCA-7463-4884-B4C9-B317CF67B763}"
           Language="1033"
           Scope="perUser">
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of pdt is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="pdt.ico" SourceFile="$(sys.SOURCEFILEDIR)pdt.ico" />
    <Property Id="ARPPRODUCTICON" Value="pdt.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalPrograms" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="pdt" />
      </Directory>
    </StandardDirectory>

    <Component Directory="INSTALLFOLDER" Guid="{0BC63BCA-7324-484F-9C3A-B6173D3C24E3}">
      <File Source="$(Payload)\pdt.exe" />
      <File Source="$(Payload)\uv.exe" />
      <File Source="$(Payload)\uv-LICENSE-MIT.txt" />
      <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="first" System="no" Permanent="no" />
      <RegistryValue Root="HKCU" Key="Software\AutoIDM\pdt" Name="InstallFolder" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      <RemoveFolder Id="RemoveLocalPrograms" Directory="LocalPrograms" On="uninstall" />
    </Component>

    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)dialog.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="pdt is installed. Open a new terminal and run pdt init to start." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open PowerShell and run pdt" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- msiexec still has the PATH from before the install, so the new PowerShell adds INSTALLFOLDER itself. -->
    <CustomAction Id="LaunchPdt" Directory="INSTALLFOLDER" Return="asyncNoWait" Impersonate="yes"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoExit -NoLogo -Command &quot;Set-Location ~; $env:Path = '[INSTALLFOLDER];' + $env:Path; pdt&quot;" />

    <!-- WixUI_Minimal without its license dialog: Next on the welcome dialog installs. -->
    <UI Id="pdt">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />

      <!-- ExitDialog from WiX, but Windows paints a check box control gray, so the box is 10 by 10 and a transparent Text control holds its label. -->
      <Dialog Id="PdtExitDialog" Width="370" Height="270" Title="!(loc.ExitDialog_Title)">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIFinish)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUICancel)" />
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.ExitDialogBitmap)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUIBack)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Description" Type="Text" X="135" Y="70" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Text="!(loc.ExitDialogDescription)" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="!(loc.ExitDialogTitle)" />
        <Control Id="OptionalText" Type="Text" X="135" Y="110" Width="220" Height="80" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="[WIXUI_EXITDIALOGOPTIONALTEXT]" ShowCondition="NOT Installed" />
        <Control Id="OptionalCheckBox" Type="CheckBox" X="135" Y="190" Width="10" Height="10" Hidden="yes" Property="WIXUI_EXITDIALOGOPTIONALCHECKBOX" CheckBoxValue="1" ShowCondition="NOT Installed" />
        <Control Id="OptionalCheckBoxText" Type="Text" X="149" Y="191" Width="206" Height="17" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="[WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT]" ShowCondition="NOT Installed" />
      </Dialog>

      <Publish Dialog="WelcomeDlg" Control="Next" Event="EndDialog" Value="Return" Condition="NOT Installed" />
      <Publish Dialog="PdtExitDialog" Control="Finish" Event="DoAction" Value="LaunchPdt" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="PdtExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" />

      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>
    <InstallUISequence>
      <Show Dialog="PdtExitDialog" OnExit="success" />
    </InstallUISequence>
    <AdminUISequence>
      <Show Dialog="PdtExitDialog" OnExit="success" />
    </AdminUISequence>
    <UIRef Id="WixUI_Common" />
  </Package>
</Wix>
