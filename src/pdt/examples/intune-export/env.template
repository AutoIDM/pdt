# ================================================================
# intune-export
# The Entra app needs these Microsoft Graph application permissions,
# with admin consent: DeviceManagementConfiguration.Read.All,
# DeviceManagementApps.Read.All, DeviceManagementServiceConfig.Read.All,
# DeviceManagementScripts.Read.All, DeviceManagementRBAC.Read.All,
# DeviceManagementManagedDevices.Read.All, Policy.Read.All,
# Agreement.Read.All, Organization.Read.All, CloudPC.Read.All,
# Group.Read.All.
# ================================================================

PDT_AZURE_TENANT_ID=
PDT_AZURE_CLIENT_ID=

# Entra ID auth: set a client secret or a certificate.
PDT_AZURE_CLIENT_SECRET=
## Certificate (PFX). Wins if both are set.
### A relative path is relative to the project folder, e.g. .secrets/app.pfx
PDT_AZURE_PRIVATE_KEY_PATH=
### Or inline the PFX as base64 of the file; wins over the path.
### Deploy converts PDT_AZURE_PRIVATE_KEY_PATH into this secret automatically.
PDT_AZURE_PRIVATE_KEY_B64=
## Optional; omit if the PFX is unencrypted.
PDT_AZURE_PRIVATE_KEY_PASSWORD=
