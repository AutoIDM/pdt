# ================================================================
# azure-license-waste
# The Entra app needs the Microsoft Graph application permissions under
# entra: in config.yml. `pdt entra azure-license-waste` creates it and
# fills in the values below. Sign-in dates need Entra ID P1 or P2.
# ================================================================

PDT_AZURE_TENANT_ID=
PDT_AZURE_CLIENT_ID=
PDT_AZURE_CLIENT_SECRET=

# Optional: days without a sign-in before an account's licenses count
# as waste. 90 when unset.
LICENSE_WASTE_INACTIVE_DAYS=
